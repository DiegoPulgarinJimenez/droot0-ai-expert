# ---------------------------------------------------------------------------
# AI Expert Chat — server-only environment variables
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values locally.
# Never commit .env or any real credential.
# Never use a NEXT_PUBLIC_ variable for secrets.

# Supabase PostgreSQL
# DATABASE_URL is the transaction-pooler connection used by the application at runtime.
# DIRECT_URL is the session-pooler (or direct) connection used for Prisma migrations.
# Keep sslmode=require for Supabase connections.

DATABASE_URL="postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Auth
SUPABASE_URL="https://project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
# Server-only. Used only by trusted scripts and admin operations.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# DeepSeek
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_TIMEOUT_MS="50000"

# Development seed
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_ADMIN_NAME="Administrator"
